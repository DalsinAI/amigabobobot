# BoboBot for AmigaOS 3.x / AmiCradle, 68040 + FPU, on acsdl12.
#
#   make -f amiga/Makefile.amigaos STOVE=/path/to/openamigagcc-16.2.0-open4-x86_64-linux \
#        NDK=/path/to/gfopensdk/OpenNDK/Include_H \
#        ACSDL=/path/to/amicradle-guest/gameports/acsdl12
#
# STOVE is GFOpenAmigaGCC 16.2.0-open4 or later. ACSDL is acsdl12, built with
# its own Makefile.amigaos (its library holds zlib's inflate, so ZLIB is
# only needed to build acsdl12). BoboBot draws with Xlib: amiga/xsdl is the
# part of Xlib it calls, on acsdl12's 8-bit screen. Its sound and music are
# SDL_mixer's, as upstream (SOUND and MUSIC on, no Linux joystick: the pad
# comes through xsdl). The pictures are amiga/images, made from images/ by
# amiga/convert_gfx.py; zak.mod is amiga/mods/zak.mod, made from the S3M
# by amiga/s3m2mod.py.
# Output: build/amigaos/BoboBot/ with the program, its data drawers, the
# HTML manual, the ReadMe and licence, and the icons; BoboBot.info beside it.

STOVE   ?= $(HOME)/CradleLab/toolchain/openamigagcc-16.2.0-open4-x86_64-linux
NDK     ?= $(HOME)/CradleLab/gfopensdk/OpenNDK/Include_H
ACSDL   ?= $(HOME)/CradleLab/guest-sdl/gameports/acsdl12
ACGAME  ?= $(ACSDL)/../acgame
ZLIB    ?= $(HOME)/CradleLab/zlib-1.3.1
CC      = $(STOVE)/bin/m68k-amigaos-gcc
CPU     ?= -m68040 -m68881
OPT     ?= -O2 -fomit-frame-pointer
CFLAGS  = -noixemul -std=gnu99 $(OPT) $(CPU) -fcommon -Wall \
          -DDATA=\"PROGDIR:\" -DSOUND_YES -DMUSIC_YES \
          -Iamiga/xsdl -I$(ACSDL)/include/SDL -I$(ACSDL)/include -I$(ACGAME)/include -I$(NDK)
LDFLAGS = -noixemul $(CPU)
BUILD   = build/amigaos
OUT     = $(BUILD)/BoboBot

UPSTREAM = bobobot window connect hints visual gc color randnum text
OBJS    = $(UPSTREAM:%=$(BUILD)/%.o) $(BUILD)/xsdl.o $(BUILD)/stack.o
XHDRS   = $(wildcard amiga/xsdl/X11/*.h) amiga/xsdl/xsdl_time.h

# BoboBot's own code sets a few locals it never reads (the Linux
# joystick's last positions and buttons, ojsx, ojsy, ojsb, are set
# outside its #ifdef JOYSTICK, and a few others); left as upstream.
UPSTREAM_W = -Wno-unused-but-set-variable

DIRS    = images sounds levels mods docs
ICONS   = amiga/icons/BoboBot-drawer.info amiga/icons/bobobot.info amiga/icons/ReadMe.info \
          amiga/icons/COPYING.info $(DIRS:%=amiga/icons/%.info)

all: $(OUT)/bobobot

$(OUT)/bobobot: $(OBJS) $(ICONS) AMIGA_PORT.md | $(OUT)
	$(CC) $(LDFLAGS) -o $@ $(OBJS) $(ACSDL)/build/amigaos/libacsdl12.a -lm
	mkdir -p $(DIRS:%=$(OUT)/%)
	cp amiga/images/*.ppm images/dark.xbm $(OUT)/images/
	cp sounds/*.wav $(OUT)/sounds/
	cp levels/*.dat $(OUT)/levels/
	cp mods/*.mod $(OUT)/mods/
	cp amiga/mods/zak.mod $(OUT)/mods/
	cp docs/* $(OUT)/docs/
	cp AMIGA_PORT.md $(OUT)/ReadMe
	cp COPYING $(OUT)/COPYING
	cp amiga/icons/bobobot.info amiga/icons/ReadMe.info amiga/icons/COPYING.info \
	   $(DIRS:%=amiga/icons/%.info) $(OUT)/
	cp amiga/icons/BoboBot-drawer.info $(BUILD)/BoboBot.info

$(BUILD)/%.o: src/%.c $(wildcard src/*.h) $(XHDRS) | $(BUILD)
	$(CC) $(CFLAGS) $(UPSTREAM_W) -c -o $@ $<

$(BUILD)/xsdl.o: amiga/xsdl/xsdl.c amiga/xsdl/font6x13.h $(XHDRS) | $(BUILD)
	$(CC) $(CFLAGS) -c -o $@ $<

$(BUILD)/stack.o: amiga/stack.c | $(BUILD)
	$(CC) $(CFLAGS) -c -o $@ $<

$(BUILD) $(OUT):
	mkdir -p $@

clean:
	rm -rf $(BUILD)

.PHONY: all clean
